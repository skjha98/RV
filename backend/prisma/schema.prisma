generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model revenue_t {
  id              Int            @id @default(autoincrement())
  bill_no         String?
  tracking_id     tracking_type
  payment_mode    payment_type
  payment_status  payment_status
  payment_date    DateTime       @db.Date
  amount_received Decimal        @db.Decimal(10, 2)
  amount_paid     Decimal        @db.Decimal(10, 2)
  amount_pending  Decimal        @db.Decimal(10, 2)
  created_at      DateTime       @default(now())
  description     String?

  flat_id     Int?
  vendor_id   Int?
  event_id Int?

  flat     flat_d?     @relation(fields: [flat_id], references: [id])
  vendor   vendor_d?   @relation(fields: [vendor_id], references: [id])
  event event_d? @relation(fields: [event_id], references: [id])
}

model revenue_stage_t {
  id              Int             @id @default(autoincrement())
  bill_no         String?
  amount_received Decimal         @db.Decimal(10, 2)
  amount_paid     Decimal         @db.Decimal(10, 2)
  amount_pending  Decimal         @db.Decimal(10, 2)
  description     String?
  created_at      DateTime        @default(now())
  payment_mode    payment_type?
  payment_date    DateTime        @db.Date
  payment_status  payment_status?
  tracking_id     tracking_type?

  flat_id     Int?
  vendor_id   Int?
  event_id Int?

  flat     flat_d?     @relation(fields: [flat_id], references: [id])
  vendor   vendor_d?   @relation(fields: [vendor_id], references: [id])
  event event_d? @relation(fields: [event_id], references: [id])
}

model event_d {
  id              Int               @id @default(autoincrement())
  name            String
  date            DateTime          @db.Date
  revenues        revenue_t[]
  staged_revenues revenue_stage_t[]
}

model flat_d {
  id              Int                  @id @default(autoincrement())
  flat_number     String
  owner_name      String?
  type            flat_type
  occupancy       flat_occupancy_type?
  mobile          String?              @db.Char(10)
  email           String?
  revenues        revenue_t[]
  staged_revenues revenue_stage_t[]
}

model vendor_d {
  id              Int               @id @default(autoincrement())
  name            String
  mobile          String?           @db.Char(10)
  revenues        revenue_t[]
  staged_revenues revenue_stage_t[]
}

enum flat_occupancy_type {
  OWNER
  TENANT
}

enum flat_type {
  MIG
  DUPLEX
}

enum payment_type {
  UPI
  CASH
  NET_BANKING
}

enum tracking_type {
  TEMPLE
  CHATT
  RWA
}

enum payment_status {
  PAID
  RECEIVED
  PENDING
  PARTIAL
}
